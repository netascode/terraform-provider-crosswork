# Crosswork Test Environment Configuration
# Copy this file to .env and fill in your actual values

# Credentials and URL of the Crosswork instance
CW_URL=https://crosswork.example.com:30603
CW_USERNAME=admin
CW_PASSWORD=changeme

# Allow an HTTPS certificate that is not trusted (default true)
CW_INSECURE=true
# Number of retries for API calls (default 3)
# CW_RETRIES=3
# Longest time in seconds to wait for the NSO plan of a service after it was written (default 300)
# CW_MAX_TIMEOUT=300
# Experimental: let a create of an existing object update it instead of failing
# CW_ALLOW_EXISTING_ON_CREATE=false
# What state a device needs before a resource that names it is written: none, synced or full (default synced)
# CW_DEVICE_READY_MODE=synced
# Longest time in seconds to wait for the devices to be ready (default 300)
# CW_DEVICE_READY_TIMEOUT=300

# Acceptance tests that change instance-wide settings (set to 1 to run them)
SETTINGS=1
# Acceptance tests of the Optimization Engine function packs (set to 1 to run them)
# OPTIMIZATION=1
# Acceptance tests of the AAA (set to 1 to run them)
# AAA=1
# Acceptance tests that need a cluster with its data gateways and devices (set to 1 to run them)
# CLUSTER=1
# Acceptance tests of the L2VPN service, and of the Ethernet OAM service (set to 1 to run them)
# L2VPN=1
# L2VPN_OAM=1
# Skip the minimum configuration test of every definition
# SKIP_MINIMUM_TEST=1

# Backup destination test: needs a working SSH/SFTP server that the Crosswork instance can reach
# SFTP=1
# TF_VAR_sftp_host=sftp.example.com
# TF_VAR_sftp_port=22
# TF_VAR_sftp_username=backup
# TF_VAR_sftp_password=changeme
# TF_VAR_sftp_remote_path=/backups

# Set to 1 to write the output of make test to test-output.log
# DEBUG=1

# Set to DEBUG to log the requests of a test run
# TF_LOG=DEBUG
# File that receives the log
# TF_LOG_PATH=/tmp/terraform-debug.log
